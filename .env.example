APP_NAME="Wide Web Blog Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=https://www.widewebblog.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=widewebblog_service
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_FOREIGN_KEYS=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=r2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=https://media.widewebblog.com
R2_REGION=auto
R2_USE_PATH_STYLE_ENDPOINT=false
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database
CACHE_PREFIX=widewebblog-service-cache
DB_CACHE_CONNECTION=
DB_CACHE_TABLE=cache

MEMCACHED_HOST=127.0.0.1

# Redis is not used by default.
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_USERNAME=null
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_CACHE_DB=1
# REDIS_PREFIX=widewebblog-service
# REDIS_QUEUE_CONNECTION=default
# REDIS_QUEUE=default
# REDIS_QUEUE_BLOCK_FOR=1
# REDIS_QUEUE_RETRY_AFTER=90

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_IMAGE_PROVIDER=gemini
AI_DEFAULT_AUDIO_PROVIDER=openai
AI_DEFAULT_TRANSCRIPTION_PROVIDER=openai
AI_DEFAULT_EMBEDDING_PROVIDER=openai
AI_DEFAULT_RERANKING_PROVIDER=cohere
AI_TIMEOUT=30
AI_RETRY_TIMES=2
AI_RETRY_SLEEP_MS=250
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=

CURRENTS_API_KEY=
FIRECRAWL_API_KEY=
